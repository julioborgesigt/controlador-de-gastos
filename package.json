{
  "name": "controlador-de-gastos",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "wrangler types && tsc --noEmit && wrangler deploy --dry-run",
    "types": "wrangler types",
    "test": "node --experimental-strip-types --test test/**/*.test.ts",
    "db:create": "wrangler d1 create controlador-de-gastos",
    "db:migrate:local": "wrangler d1 migrations apply controlador-de-gastos --local",
    "db:migrate": "wrangler d1 migrations apply controlador-de-gastos --remote"
  },
  "dependencies": {
    "hono": "^4.10.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.50.0"
  }
}
